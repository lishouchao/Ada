[Unit]
Description=Ada AI Assistant
Documentation=https://github.com/nebula/ada
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ada-daemon
Restart=on-failure
RestartSec=5

# Environment
Environment="ADA_MODE=daemon"
Environment="ADA_LOG_LEVEL=info"

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/ada
ReadWritePaths=%h/.config/ada

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=default.target
