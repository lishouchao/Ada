#!/usr/bin/env python3
"""
Ada launcher script template.

This script is configured by meson with the correct Python path.
"""

import sys
import os

# Add the installation directory to Python path
PREFIX = '@PREFIX@'
sys.path.insert(0, os.path.join(PREFIX, 'lib', 'python3', 'site-packages'))

from ada.cli import main

if __name__ == '__main__':
    sys.exit(main())
