{
    "app-id": "org.nebula.Ada",
    "runtime": "org.gnome.Platform",
    "runtime-version": "45",
    "sdk": "org.gnome.Sdk",
    "command": "ada",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--share=network",
        "--filesystem=home",
        "--filesystem=/run/user",
        "--filesystem=/tmp",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--talk-name=org.freedesktop.portal.FileChooser",
        "--talk-name=org.gnome.Shell",
        "--talk-name=org.gtk.vfs.*",
        "--system-talk-name=org.freedesktop.login1",
        "--system-talk-name=org.freedesktop.systemd1"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "python3-python-dotenv",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"python-dotenv\""
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/py3/p/python-dotenv/python_dotenv-1.0.0-py3-none-any.whl",
                    "sha256": "f1776f1b0e2f5c8cfc5d0fb1b1a6d2c3d8e9f0c8b7a6e5d4c3b2a1908765432109"
                }
            ]
        },
        {
            "name": "python3-pydantic",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pydantic\""
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/py3/p/pydantic/pydantic-2.5.0-py3-none-any.whl",
                    "sha256": "dummy-sha256"
                }
            ]
        },
        {
            "name": "ada",
            "buildsystem": "meson",
            "config-opts": [
                "--prefix=/app"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
